# Database
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Security
ENCRYPTION_SECRET=
CRON_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Time is Money <onboarding@resend.dev>

# OpenAI (optional — Jarvis falls back to heuristic parser)
OPENAI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# @tim/api — em produção Vercel: NÃO defina (Hono embutido em /api/v1 no Next).
# Local com `pnpm dev` (web+api): http://localhost:3001
API_URL=http://localhost:3001
PORT=3001
HOST=0.0.0.0
# Variáveis acima + DATABASE_URL, CLERK_*, ENCRYPTION_SECRET: apps/web/.env.local
# Prod: ver docs/ops/deploy.md

# Demo local (sem Clerk) — NUNCA em produção
DEMO_MODE=0

# UI mock offline (sem API, banco nem Clerk) — só Next.js — NUNCA em produção
MOCK_API=0
NEXT_PUBLIC_MOCK_API=0
